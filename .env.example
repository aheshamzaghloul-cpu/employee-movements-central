# Set a unique random value of at least 32 characters in production. Never commit real secrets.
APP_ENV=production
SECRET_KEY=replace-with-a-unique-random-secret-at-least-32-characters
DATABASE_URL=postgresql://user:password@host:5432/database

# Initial application administrator (created once if username does not exist).
BOOTSTRAP_ADMIN_USERNAME=admin
BOOTSTRAP_ADMIN_PASSWORD=replace-with-a-unique-password-at-least-12-characters

# Temporary full-review account. Enable only during the review window.
# Keep credentials in deployment secrets, not in GitHub or chat.
REVIEW_ACCOUNT_ENABLED=0
REVIEW_USERNAME=full_review_test
REVIEW_PASSWORD=replace-with-a-unique-random-password-at-least-16-characters

# Assistant integration is informational only in this build; no writes are enabled.
GEMINI_API_KEY=
