{% extends 'base.html' %}{% block title %}تسجيل حركة{% endblock %}{% block content %}
<div class="toolbar"><div><h1>تسجيل حركة</h1><p class="subtitle">اختر الموظف ونوع الحركة فقط، وستظهر لك البيانات المطلوبة تلقائيًا.</p></div><a class="btn secondary" href="/employees">العودة للموظفين</a></div>
<div class="box smart-movement-box">
<form method="post" id="movement_form"><input type="hidden" name="_csrf" value="{{csrf}}">
<div class="step-title"><span>1</span><div><b>اختيار الموظف</b><small>ابحث بالاسم أو كود شئون العاملين</small></div></div>
<div class="employee-picker"><input id="movement_employee_search" type="search" placeholder="🔎 اكتب اسم الموظف أو الكود..." autocomplete="off"><select name="employee_id" id="movement_employee" required><option value="">اختر الموظف</option>{% for e in emps %}<option value="{{e.id}}" data-search="{{e.full_name }} {{e.employee_code }} {{e.branch.name}}" {% if selected_employee_id==e.id %}selected{% endif %}>{{e.full_name}} — {{e.employee_code}} — {{e.branch.name}}</option>{% endfor %}</select><div id="employee_match_count" class="hint"></div></div>
<div class="step-title" style="margin-top:20px"><span>2</span><div><b>نوع الحركة</b><small>اختر نوعًا واحدًا</small></div></div>
<div class="movement-typebar"><label><input type="radio" name="movement_type" value="إجازة" checked><span>📅 إجازة</span></label><label><input type="radio" name="movement_type" value="انتداب"><span>✈️ انتداب</span></label><label><input type="radio" name="movement_type" value="إذن"><span>🕐 إذن</span></label></div>
<div id="movement_hint" class="movement-helper">سجّل نوع الإجازة وفترة الإجازة.</div>
<div class="grid wide smart-fields">
<label data-movement="إجازة">نوع الإجازة<select name="leave_type" id="leave_type"><option value="">اختر نوع الإجازة</option>{% for x in leave_types %}<option>{{x}}</option>{% endfor %}</select></label>
<label data-movement="انتداب" hidden>الفرع المنتدب إليه<select name="destination_branch_id" id="destination_branch_id"><option value="">اختر الفرع</option>{% for b in bs %}<option value="{{b.id}}">{{b.governorate.name}} — {{b.name}}</option>{% endfor %}</select></label>
<label data-movement="إجازة" data-movement2="انتداب">من تاريخ<input type="date" name="from_date" id="from_date"></label>
<label data-movement="إجازة" data-movement2="انتداب">إلى تاريخ<input type="date" name="to_date" id="to_date"></label>
<label data-movement="إذن" hidden>تاريخ الإذن<input type="date" name="permission_date" id="permission_date"></label>
</div>
<div class="duration-box"><b>المدة</b><strong id="movement_days">—</strong><span>يوم</span><small>تحسب تلقائيًا للإجازة والانتداب</small></div>
<div class="form-actions"><button type="submit">حفظ الحركة</button><button class="secondary" type="submit" name="action" value="مدخلة">حفظ وإرسال للمراجعة</button><a class="btn secondary" id="open_employee_card" href="#" hidden>فتح بطاقة الموظف</a></div>
</form></div>
<div class="box tablewrap"><div class="section-title"><h3>آخر الحركات</h3><input style="max-width:320px" data-auto-search="#movements-table" placeholder="بحث سريع..."></div><table id="movements-table"><thead><tr><th>الموظف</th><th>الحركة</th><th>التاريخ</th><th>الحالة</th><th>إجراءات</th></tr></thead><tbody>{% for m in rows %}<tr><td><a href="/employee/{{m.employee.id}}">{{m.employee.full_name}}</a></td><td>{{m.movement_type}}{% if m.leave_type %}<br><small>{{m.leave_type}}</small>{% endif %}</td><td>{{m.from_date or m.permission_date or '-'}}{% if m.to_date %} إلى {{m.to_date}}{% endif %}</td><td><span class="tag">{{m.status}}</span></td><td>{% if m.status!='معتمدة' %}<a class="btn secondary mini" href="/movements/{{m.id}}/edit">تعديل</a>{% if m.status in ['مسودة','مدخلة','مرفوضة'] %}<form class="inline" method="post" action="/movements/{{m.id}}/submit"><input type="hidden" name="_csrf" value="{{csrf}}"><button class="mini">إرسال للمراجعة</button></form>{% endif %}{% endif %}{% if m.status=='تحت المراجعة' and ('مسؤول التطبيق' in roles or 'مشرف محافظة' in roles) %}<form class="inline" method="post" action="/movements/{{m.id}}/status"><input type="hidden" name="_csrf" value="{{csrf}}"><input type="hidden" name="status" value="معتمدة"><button class="green mini">اعتماد</button></form><form class="inline" method="post" action="/movements/{{m.id}}/status"><input type="hidden" name="_csrf" value="{{csrf}}"><input type="hidden" name="status" value="مرفوضة"><button class="red mini">رفض</button></form>{% endif %}{% if m.status!='معتمدة' %}<form class="inline" method="post" action="/movements/{{m.id}}/delete"><input type="hidden" name="_csrf" value="{{csrf}}"><button class="red mini" data-confirm="هل تريد حذف الحركة؟">حذف</button></form>{% endif %}</td></tr>{% else %}<tr><td colspan="5" class="empty">لا توجد حركات حتى الآن.</td></tr>{% endfor %}</tbody></table></div>{% endblock %}
