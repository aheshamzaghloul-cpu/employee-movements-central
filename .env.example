# انسخ هذا الملف إلى .env ثم استبدل القيم التجريبية قبل تشغيل التطبيق.
# لا ترفع ملف .env الفعلي إلى GitHub أو تشاركه.

APP_ENV=production

# PostgreSQL — استخدم كلمة مرور URL-safe (حروف/أرقام/شرطة/شرطة سفلية) لتجنب كسر DATABASE_URL.
POSTGRES_DB=movements
POSTGRES_USER=movements_app
POSTGRES_PASSWORD=REPLACE_WITH_LONG_RANDOM_URL_SAFE_PASSWORD

# مفتاح Flask عشوائي بطول 32 حرفًا على الأقل. يمكن إنشاؤه بـ:
# python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=REPLACE_WITH_RANDOM_SECRET_KEY_AT_LEAST_32_CHARS

# حساب مسؤول التطبيق الأول — يُستخدم للإنشاء الأول فقط.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=REPLACE_WITH_LONG_UNIQUE_ADMIN_PASSWORD
ADMIN_EMAIL=

# في الإنتاج خلف HTTPS يجب أن يكون 1.
COOKIE_SECURE=1
DOMAIN=REPLACE_WITH_REAL_DOMAIN

# Gemini اختياري؛ اترك المفتاح فارغًا لتعطيل المساعد المعتمد على Gemini.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash
GEMINI_TIMEOUT=20
ASSISTANT_TIMEOUT_SECONDS=8
ASSISTANT_RATE_LIMIT=30
LOGIN_RATE_LIMIT=10

# اختياري: Redis مشترك لتطبيق حد المحاولات على جميع العمال/النسخ. اتركه فارغًا إن لم يتوفر.
REDIS_URL=

# فعّله في بيئة الاختبار لرصد مخالفات CSP دون تعطيل الواجهة الحالية.
CSP_REPORT_ONLY=0
SLOW_REQUEST_LOG_MS=1500

# إعدادات قاعدة البيانات والإقلاع.
DB_CONNECT_TIMEOUT=10
DB_POOL_RECYCLE=1800
DB_INIT_RETRIES=8
DB_INIT_RETRY_DELAY=3
INIT_DATABASE=1
WEB_CONCURRENCY=3
