# انسخ هذا الملف إلى .env ولا ترفعه إلى GitHub.
# --- الوضع ---------------------------------------------------------------
APP_ENV=production            # production | development | testing
DOMAIN=movements.example.com  # مطلوب لـ docker compose (Caddy/HTTPS)

# --- قاعدة البيانات ------------------------------------------------------
POSTGRES_DB=movements
POSTGRES_USER=movements_app
POSTGRES_PASSWORD=
# للتشغيل بدون compose: DATABASE_URL=postgresql://user:pass@host:5432/movements
# (يُقبل أيضًا postgres:// ويُحوَّل تلقائيًا). الافتراضي في التطوير: SQLite محلي.

# --- الأمان --------------------------------------------------------------
# 32 حرفًا على الأقل: python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=
COOKIE_SECURE=1               # اجعله 0 فقط للتجربة المحلية عبر HTTP

# --- حساب المسؤول (يُنشأ عند أول تشغيل فقط) ------------------------------
ADMIN_USERNAME=admin
ADMIN_PASSWORD=
ADMIN_EMAIL=

# --- المساعد الذكي (اختياري) --------------------------------------------
# بدون مفتاح يعمل المساعد بالفهم المحلي فقط ولا تُرسل أي بيانات إلى طرف خارجي.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.6-flash
GEMINI_TIMEOUT=20

# --- حدود الاستخدام ------------------------------------------------------
LOGIN_RATE_LIMIT=10           # محاولات فاشلة لكل 15 دقيقة (IP + اسم المستخدم)
ASSISTANT_RATE_LIMIT=30       # طلبات المساعد لكل مستخدم في الدقيقة
